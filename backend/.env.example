PORT=5001
NODE_ENV=development

# Local SQLite by default. The RAMS test DB is
# libsql://royalmart-rams-test-royalmart.aws-ap-south-1.turso.io (token from the
# Turso dashboard). Check which DB this points at before `npm run migrate`.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Different from ROMS's. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS — comma-separated list of allowed origins (the RAMS frontend).
FRONTEND_URL=http://localhost:5174

# The first day of Tally books RAMS mirrors: the start of the financial year,
# so Attachments matches Tally's registers month by month. Moving it earlier
# needs a resync of each company.
RAMS_SYNC_FROM=2026-04-01

# The first day matching and auto-fill look at: ROMS go-live, since ROMS has
# no POs before it. Invoices before it are never "no PO". Never before
# RAMS_SYNC_FROM.
RAMS_MATCH_FROM=2026-06-08

# Reading ROMS for matching (M5): ROMS's address and its INTEGRATION_TOKEN
# (ROMS backend .env). Read-only. Leave both blank and matching runs on the
# last copy RAMS read, and the pages say ROMS isn't connected.
ROMS_API_URL=
ROMS_INTEGRATION_TOKEN=

# npm run bootstrap-admin only: the first Admin, created once when no Admin
# exists. Must change the password at first sign-in. Remove after use.
RAMS_ADMIN_USERNAME=
RAMS_ADMIN_PASSWORD=
RAMS_ADMIN_NAME=
